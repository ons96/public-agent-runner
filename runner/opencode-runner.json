{
  "plugin": ["@kodrunhq/opencode-autopilot"],
  "model": "vps-gateway/coding-elite",
  "provider": {
    "vps-gateway": {
      "apiKey": "{file:vps-gateway.key}",
      "baseURL": "https://llm-gateway.tail712653.ts.net/v1",
      "models": {
        "coding-elite": "coding-elite",
        "coding-smart": "coding-smart",
        "coding-fast": "coding-fast",
        "chat-smart": "chat-smart",
        "chat-fast": "chat-fast"
      }
    },
    "nvidia": {
      "apiKey": "{file:nvidia.key}",
      "baseURL": "https://integrate.api.nvidia.com/v1",
      "models": {
        "default": "meta/llama-3.3-70b-instruct",
        "fast": "meta/llama-3.1-8b-instruct"
      }
    },
    "openrouter": {
      "apiKey": "{file:openrouter.key}",
      "baseURL": "https://openrouter.ai/api/v1",
      "models": {
        "default": "deepseek/deepseek-v4-flash:free",
        "fast": "google/gemma-4-26b:free"
      }
    }
  }
}
